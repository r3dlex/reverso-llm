<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent template for the Reverso LiteLLM proxy.

  Install via:
    scripts/install-launchagents.sh

  Variables expanded by install-launchagents.sh (sed substitution):
    {{REVERSO_DIR}}   - absolute path to the reverso/ project root
    {{REVERSO_DEPLOYMENT_COMMIT}} - exact installed Git revision
    {{UV_BIN}}        - absolute path to the uv binary (e.g. /Users/you/.local/bin/uv)
    {{USER_HOME}}     - $HOME of the running user
    {{KIMI_CODE_HOME}} - governed isolated Kimi CLI data root
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.reverso-proxy</string>

    <key>Program</key>
    <string>{{UV_BIN}}</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{UV_BIN}}</string>
        <string>run</string>
        <string>--project</string>
        <string>{{REVERSO_DIR}}</string>
        <string>reverso-proxy</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{REVERSO_DIR}}</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- Keychain secrets are loaded at process startup by reverso-proxy. -->
        <!-- Add any static env overrides here if needed. -->
        <key>REVERSO_DEPLOYMENT_COMMIT</key>
        <string>{{REVERSO_DEPLOYMENT_COMMIT}}</string>
        <key>REVERSO_PROJECT_DIR</key>
        <string>{{REVERSO_DIR}}</string>
        <key>KIMI_CODE_HOME</key>
        <string>{{KIMI_CODE_HOME}}</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:{{USER_HOME}}/.local/bin</string>
        <key>REVERSO_HOST</key>
        <string>127.0.0.1</string>
        <key>REVERSO_PORT</key>
        <string>64946</string>
        <key>REVERSO_HEADROOM_TIMEOUT</key>
        <string>30</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>{{USER_HOME}}/Library/Logs/reverso/proxy.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>{{USER_HOME}}/Library/Logs/reverso/proxy.stderr.log</string>

    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
